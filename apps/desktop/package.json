{
  "name": "desktop-app",
  "version": "0.1.0",
  "description": "Unified launcher for Steam and Legendary games",
  "author": {
    "name": "Nexus Play",
    "email": "admin@nexusplay.com"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/unified_launcher.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "npm run build && electron-builder",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite"
  },
  "dependencies": {
    "@nexus-play/core": "*",
    "@nexus-play/plugins": "*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.29.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "drizzle-kit": "^0.20.14",
    "electron": "29.4.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "org.nexusplay.launcher",
    "productName": "Nexus Play",
    "electronVersion": "29.4.6",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman",
        "tar.gz"
      ],
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "yourusername",
      "repo": "unified_launcher"
    }
  }
}
