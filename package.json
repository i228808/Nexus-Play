{
  "name": "nexus-play-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Electron Game Launcher for Linux",
  "workspaces": [
    "apps/desktop",
    "packages/core",
    "packages/plugins"
  ],
  "scripts": {
    "dev": "bun --cwd apps/desktop run dev",
    "build": "bun --cwd apps/desktop run build",
    "package": "bun --cwd apps/desktop run package",
    "db:generate": "bun --cwd apps/desktop run db:generate",
    "db:push": "bun --cwd apps/desktop run db:push"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
